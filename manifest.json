
{
  "manifest_version": 3,
  "name": "GTA VI Spoiler Blocker",
  "version": "1.0.0",
  "description": "Protege tu experiencia en YouTube contra spoilers de GTA VI.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
